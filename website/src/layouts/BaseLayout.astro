---
/**
 * Base layout for every documentation page.
 *
 * Renders the shared chrome (header, sidebar, footer) around the page body and
 * derives the sidebar from the content collection, so a new Markdown file shows
 * up in navigation without editing this component or any navigation list.
 */
import {
  LOCALE_LABELS,
  LOCALES,
  SECTIONS,
  alternateHref,
  localeBase,
  sidebarItems,
  type Locale,
} from '../lib/nav';
import '../styles/theme.css';

interface Props {
  /** Page title; combined with the site name in the browser tab. */
  title: string;
  /** Meta description, normally the page frontmatter `description`. */
  description: string;
  /** Locale this page is written in. */
  locale: Locale;
  /** Counterpart page in the other language tree, as declared in frontmatter. */
  alternate: string;
  /** Site path of the current page, used for the active sidebar entry. */
  currentPath: string;
}

const { title, description, locale, alternate, currentPath } = Astro.props;

// The configured `base` is recovered from the current URL: in a static build the
// pathname always starts with it, so removing the locale segment leaves the
// prefix that every link and asset must carry.
const [base] = Astro.url.pathname.split(`/${locale}/`);
const basePrefix = base!.endsWith('/') ? base! : `${base!}/`;
const otherLocale: Locale = locale === 'en' ? 'zh-CN' : 'en';

// One sidebar group per section, each listing the pages that exist for this locale.
const groups = await Promise.all(
  SECTIONS.map(async (section) => ({
    id: section.id,
    title: section.title[locale],
    items: await sidebarItems(basePrefix, locale, section.id),
  })),
);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Nanobug</title>
    <meta name="description" content={description} />
    <!-- Carry the project prefix on branding assets just like documentation links. -->
    <link rel="icon" href={`${basePrefix}favicon.ico`} sizes="any" />
    <link rel="alternate" hreflang={otherLocale} href={alternateHref(basePrefix, alternate)} />
  </head>
  <body>
    <header class="site-header">
      <a class="site-title" href={localeBase(basePrefix, locale)}>
        <img src={`${basePrefix}nanobug.png`} alt="" width="28" height="28" />
        Nanobug
      </a>
      <nav>
        <a class="header-link" href={`${basePrefix}${locale}/search/`}>
          {locale === 'en' ? 'Search' : '搜索'}
        </a>
        <span class="locale-switch">
          {
            LOCALES.map((candidate, index) => (
              <>
                {index > 0 && <span aria-hidden="true">/</span>}
                <a
                  href={candidate === locale ? currentPath : alternateHref(basePrefix, alternate)}
                  hreflang={candidate}
                  aria-current={candidate === locale ? 'true' : 'false'}
                >
                  {LOCALE_LABELS[candidate]}
                </a>
              </>
            ))
          }
        </span>
      </nav>
    </header>

    <div class="shell">
      <aside class="sidebar">
        {
          groups.map((group) => (
            <div class="sidebar-section">
              <h2>{group.title}</h2>
              {group.items.length === 0 ? (
                <p class="sidebar-empty">{locale === 'en' ? 'In progress' : '整理中'}</p>
              ) : (
                <ul>
                  {group.items.map((item) => (
                    <li>
                      <a href={item.href} aria-current={item.href === currentPath ? 'page' : 'false'}>
                        {item.title}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))
        }
      </aside>

      <!--
        Search indexes only the article body: including the navigation and footer would
        make every page match the sidebar's page titles.
      -->
      <main class="article" data-pagefind-body data-pagefind-meta={`locale:${locale}`}>
        <slot />
      </main>
    </div>

    <footer class="page-footer">
      <p>
        {
          locale === 'en'
            ? 'Nanobug is a native desktop editor. This site documents editor usage and the plugin contract.'
            : 'Nanobug 是原生桌面编辑器。本站记录编辑器使用方式与插件契约。'
        }
      </p>
    </footer>
  </body>
</html>
