# Locked package dependency hashes refer to these exact generated bytes on every checkout.
# Preserve bundles instead of applying the developer machine's automatic line-ending conversion.
plugins/html/native/server.cjs -text -whitespace
plugins/javascript/native/server.cjs -text -whitespace
# Keep the locked dependency notice verbatim when verifying its distributed byte identity.
plugins/javascript/licenses/native/typescript-ThirdPartyNoticeText.txt -text -whitespace
# Copied upstream notices and generated bundles retain upstream whitespace; authored source stays checked.
plugins/html/licenses/native/* -whitespace
plugins/javascript/licenses/native/* -whitespace
