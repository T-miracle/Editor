        },
        "explorer-row": {
          "hover": { "background": "#393b40" },
          "selected": { "background": "#2e436e", "border": "#3574f0" }
        },
        "explorer-menu": {
          "base": { "background": "#2b2d30", "foreground": "#dfe1e5", "border": "#43454a", "radius_px": 6, "font_size_px": 13, "padding_x_px": 6, "padding_y_px": 5 },
          "hover": { "background": "#2e436e", "foreground": "#dfe1e5" }
        },
        "editor-tabs": {
