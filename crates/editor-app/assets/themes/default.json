            "magenta": "#c9a7e8",
            "cyan": "#71c6d7",
            "white": "#dfe1e5",
            "bright_black": "#a6a9b1",
            "bright_red": "#ff8a87",
            "bright_green": "#96d6a4",
            "bright_yellow": "#e2c58d",
            "bright_blue": "#92b7ff",
            "bright_magenta": "#d8b7f0",
            "bright_cyan": "#8fd3df",
            "bright_white": "#f7f8fa"
          }
        }
      },
      "components": {
        "app-shell": {
          "base": { "background": "#1e1f22", "foreground": "#dfe1e5" }
        },
        "window-title-bar": {
          "base": { "background": "#2b2d30", "foreground": "#dfe1e5", "border": "#43454a" }
        },
        "project-badge": {
          "base": { "background": "#3574f0", "foreground": "#ffffff" }
        },
        "explorer-tree": {
