        "hover": "#393b40",
        "border": "#43454a",
        "foreground": "#dfe1e5",
        "muted_foreground": "#9da0a8",
        "selection": "#2e436e",
        "accent": "#3574f0",
        "accent_hover": "#4682fa",
        "accent_active": "#2f65ca"
      },
      "typography": {
        "ui": { "family": "Segoe UI" },
        "mono": { "family": "Cascadia Mono" }
      },
      "plugins": {
        "me.terminal": {
          "typography": {
            "content": { "family": "Cascadia Mono", "size_px": 14 },
            "tab": { "family": "Segoe UI", "size_px": 14 },
            "menu": { "family": "Segoe UI", "size_px": 14 },
