{
  "schema_version": 1,
  "themes": [
    {
      "id": "builtin-light",
      "name": "Default Light",
      "mode": "light",
      "colors": {
        "background": "#ffffff",
        "surface": "#f7f8fa",
        "hover": "#ebecf0",
        "border": "#d3d5db",
        "foreground": "#1f2329",
        "muted_foreground": "#6c707e",
        "selection": "#d4e2ff",
        "accent": "#3574f0",
        "accent_hover": "#2f65ca",
        "accent_active": "#2554a8"
      },
      "typography": {
        "ui": { "family": "Segoe UI" },
        "mono": { "family": "Cascadia Mono" }
      },
      "plugins": {
        "me.terminal": {
          "typography": {
            "content": { "family": "Cascadia Mono", "size_px": 14 },
            "tab": { "family": "Segoe UI", "size_px": 14 },
            "menu": { "family": "Segoe UI", "size_px": 14 },
            "error": { "family": "Segoe UI", "size_px": 13 }
          },
          "ansi": {
            "black": "#1f2329",
            "red": "#b42318",
            "green": "#1a7f46",
            "yellow": "#8a5a00",
            "blue": "#175cd3",
            "magenta": "#8250df",
            "cyan": "#096d83",
            "white": "#6c707e",
            "bright_black": "#59616e",
            "bright_red": "#c0322b",
            "bright_green": "#167c42",
            "bright_yellow": "#795100",
            "bright_blue": "#1d64d8",
            "bright_magenta": "#7a3ecc",
            "bright_cyan": "#086e80",
            "bright_white": "#1f2329"
          }
        }
      },
      "components": {
        "app-shell": {
          "base": { "background": "#ffffff", "foreground": "#1f2329" }
        },
        "window-title-bar": {
          "base": { "background": "#f7f8fa", "foreground": "#1f2329", "border": "#d3d5db" }
        },
        "project-badge": {
          "base": { "background": "#3574f0", "foreground": "#ffffff" }
        },
        "explorer-tree": {
          "base": { "background": "#ffffff", "foreground": "#1f2329" }
        },
        "explorer-row": {
          "hover": { "background": "#ebecf0" },
          "selected": { "background": "#d4e2ff", "border": "#3574f0" }
        },
        "explorer-menu": {
          "base": { "background": "#f7f8fa", "foreground": "#1f2329", "border": "#d3d5db", "radius_px": 6, "font_size_px": 13, "padding_x_px": 6, "padding_y_px": 5 },
          "hover": { "background": "#d4e2ff", "foreground": "#1f2329" }
        },
        "editor-tabs": {
          "base": { "background": "#f7f8fa", "border": "#d3d5db" },
          "active": { "background": "#3574f0" }
        },
        "editor-tab": {
          "base": { "background": "#f7f8fa", "foreground": "#6c707e", "border": "#d3d5db" },
          "selected": { "background": "#ffffff", "foreground": "#3574f0", "border": "#3574f0" }
        },
        "editor-tab-close": {
          "hover": { "background": "#ebecf0" }
        },
        "editor-tab-drag-preview": {
          "base": { "background": "#3574f0", "foreground": "#ffffff" }
        },
        "editor": {
          "base": { "background": "#ffffff", "foreground": "#1f2329" }
        },
        "scrollbar": {
          "base": { "background": "#9bd3ff" },
          "hover": { "background": "#87c8ff" },
          "active": { "background": "#75bcf5" }
        },
        "panel-toggle": {
          "selected": { "background": "#d4e2ff", "foreground": "#1f2329" }
        },
        "dock-title-bar": {
          "base": { "background": "#f7f8fa", "foreground": "#1f2329", "border": "#d3d5db" }
        },
        "dock-tab": {
          "base": { "background": "#f7f8fa", "foreground": "#6c707e", "border": "#d3d5db" },
          "selected": { "background": "#ffffff", "foreground": "#1f2329" }
        },
        "dock-drag-preview": {
          "base": { "background": "#f7f8fa", "border": "#d3d5db" }
        },
        "status-bar": {
          "base": { "background": "#f7f8fa", "foreground": "#6c707e", "border": "#d3d5db" }
        }
      }
    },
    {
      "id": "jetbrains-dark",
