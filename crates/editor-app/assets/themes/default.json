        "editor-tab": {
          "base": { "background": "#2b2d30", "foreground": "#9da0a8", "border": "#43454a" },
          "selected": { "background": "#1e1f22", "foreground": "#3574f0", "border": "#3574f0" }
        },
        "editor-tab-close": {
          "hover": { "background": "#393b40" }
        },
        "editor-tab-drag-preview": {
          "base": { "background": "#3574f0", "foreground": "#ffffff" }
        },
        "editor": {
          "base": { "background": "#1e1f22", "foreground": "#dfe1e5" }
        },
        "scrollbar": {
          "base": { "background": "#9bd3ff" },
          "hover": { "background": "#87c8ff" },
          "active": { "background": "#75bcf5" }
        },
        "panel-toggle": {
          "selected": { "background": "#2e436e", "foreground": "#dfe1e5" }
        },
        "dock-title-bar": {
          "base": { "background": "#2b2d30", "foreground": "#dfe1e5", "border": "#43454a" }
        },
        "dock-tab": {
          "base": { "background": "#2b2d30", "foreground": "#9da0a8", "border": "#43454a" },
          "selected": { "background": "#1e1f22", "foreground": "#dfe1e5" }
        },
        "dock-drag-preview": {
          "base": { "background": "#2b2d30", "border": "#43454a" }
        },
        "status-bar": {
          "base": { "background": "#2b2d30", "foreground": "#9da0a8", "border": "#43454a" }
        }
      }
    }
  ]
}
