{
  "id": "html",
  "name": "HTML",
  "version": "0.3.0",
  "protocol": 7,
  "contributions": "plugin.toml",
  "permissions": [
    "process.service.analysis",
    "dependencies.prepare"
  ],
  "storage_limit": 1024,
  "api": {
    "base": "^1",
    "required": {
      "language.lsp": ">=1.3,<2",
      "language.formatting": "^1",
      "language.editing": ">=1.1, <2",
      "process": "^1",
      "dependencies": ">=1.1,<2"
    }
  },
  "services": {
    "analysis": {
      "program": "node.exe",
      "args": [
        "${dependency:server}/server.cjs"
      ],
      "installation": {
        "artifacts": [
          {
            "id": "node",
            "version": "24.19.0",
            "platform": "windows-x86_64",
            "sha256": "3602f2bb1a10f2cbab4c36886218a33c1ab3db87290e73b033c46c77147d0237",
            "source": {
              "kind": "url",
              "url": "https://nodejs.org/dist/v24.19.0/win-x64/node.exe"
            },
            "format": {
              "kind": "file",
              "path": "node.exe"
            }
          },
          {
            "id": "server",
            "version": "0.3.0",
            "platform": "windows-x86_64",
            "sha256": "f4bdb38e96a0f996bf49ea94b2e11c11ee4922149192ebe5fa031615795f9ef1",
            "source": {
              "kind": "package",
              "path": "native/server.cjs"
            },
            "format": {
              "kind": "file",
              "path": "server.cjs"
            }
          }
        ],
        "executable": "node/node.exe"
      }
    }
  },
  "language_servers": [
    {
      "id": "analysis",
      "language": "html",
      "service": "analysis",
      "formatting": true,
      "editing": true,
      "completion_triggers": [
        "<",
        "/",
        "=",
        "\""
      ],
      "completion_after_whitespace": [
        ""
      ]
    }
  ]
}
