{
  "id": "terminal",
  "name": "终端",
  "version": "0.10.0",
  "protocol": 7,
  "api": {
    "base": "^1",
    "required": {
      "process": ">=1.4, <2", "ui.native": "^1", "ui.canvas": ">=1.1, <2", "ui.grid": "^1",
      "ui.collections": "^1", "ui.panels": "^1", "ui.clipboard": "^1", "editor.documents": "^1",
      "workspace.files": "^1", "storage.private": "^1", "storage.editor": "^1", "storage.migration": "^1", "plugin.services": "^1"
    }
  },
  "data_format": {"version": 1, "migration_hook": true},
  "plugin_services": {"provides": {"interactive.execute": {"version":"1.3.0", "methods": {
    "execute": {
      "parameters":{"type":"record", "fields":{
        "program":{"type":"string","max_bytes":4096},
        "args":{"type":"array","max_items":128,"items":{"type":"string","max_bytes":4096}},
        "cwd":{"type":"string","max_bytes":4096},
        "name":{"type":"string","max_bytes":256},
        "env":{"type":"array","max_items":64,"items":{"type":"record","fields":{
          "name":{"type":"string","max_bytes":128},
          "value":{"type":"string","max_bytes":32768}}}}
      }, "optional":["cwd","name","env"]},
      "result":{"type":"record","fields":{
        "session":{"type":"string","max_bytes":128},
        "state":{"type":"string","max_bytes":32}
      }},
      "permissions":["process.exec","ui.panels"]
    },
    "stop": {
      "parameters":{"type":"record", "fields":{
        "session":{"type":"string","max_bytes":128}
      }},
      "result":{"type":"record","fields":{
        "session":{"type":"string","max_bytes":128},
        "state":{"type":"string","max_bytes":32}
      }},
      "permissions":["process.exec"]
    },
    "status": {
      "parameters":{"type":"record", "fields":{
        "session":{"type":"string","max_bytes":128}
      }},
      "result":{"type":"record","fields":{
        "session":{"type":"string","max_bytes":128},
        "state":{"type":"string","max_bytes":32},
        "code":{"type":"integer","min":0,"max":2147483647}
      }, "optional":["code"]},
      "permissions":["process.exec"]
    }
  }}}},
  "component": "terminal.wasm",
  "permissions": ["process.exec", "workspace.read", "storage", "clipboard", "editor.read", "editor.write", "ui.panels"],
  "storage_limit": 16777216,
  "panels": [{"id":"terminal", "title":"终端", "position":"bottom", "default_visible":false, "status_order":0, "icon_light":"icons/terminal_light.svg", "icon_dark":"icons/terminal_dark.svg"}],
  "commands": [
    {"id":"terminal.new","title":"新建终端","shortcut":"ctrl-shift-t","menu":true,"toolbar_icon":"icons/plus.svg"},
    {"id":"terminal.menu","title":"终端菜单","menu":false,"toolbar_icon":"icons/chevron-down.svg"},
    {"id":"terminal.run","title":"运行项目","menu":true},
    {"id":"terminal.here","title":"在当前目录新建终端","shortcut":"ctrl-alt-enter","menu":true},
    {"id":"terminal.selection","title":"发送选中内容","shortcut":"ctrl-shift-enter","menu":true},
    {"id":"terminal.close","title":"关闭终端","shortcut":"ctrl-shift-w","menu":true},
    {"id":"terminal.next","title":"下一个终端","shortcut":"ctrl-pagedown","menu":true},
    {"id":"terminal.previous","title":"上一个终端","shortcut":"ctrl-pageup","menu":true},
    {"id":"terminal.settings","title":"终端主题与配置","menu":true},
    {"id":"terminal.reload","title":"重新加载终端配置","menu":true}
  ]
}
