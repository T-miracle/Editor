{
  "id": "generated-preview",
  "name": "Generated Preview",
  "version": "0.1.0",
  "protocol": 7,
  "api": { "base": "^1", "required": { "ui.native": "^1", "editor.documents": "^1.1", "editor.virtual": "^1", "editor.diff": "^1" } },
  "component": "generated-preview.wasm",
  "permissions": ["editor.read", "workspace.read", "ui.panels"],
  "panels": [{ "id": "generated", "title": "Generated Preview", "position": "right" }],
  "commands": [
    { "id": "probe", "title": "Inspect generated document contract" },
    { "id": "preview-generated", "title": "Preview generated text", "menu": true }
  ],
  "storage_limit": 4096
}
