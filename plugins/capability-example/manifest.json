{
  "id": "capability-example",
  "name": "Capability Example",
  "version": "0.18.0",
  "settings_hook": true,
  "settings": {
    "enabled": { "title": "启用示例功能", "value_type": { "kind": "boolean" }, "default": true, "scope": "project", "apply": "restart_instance" },
    "label": { "title": "显示文本", "value_type": { "kind": "string", "max_length": 120 }, "default": "Default label", "scope": "project", "apply": "restart_instance" },
    "count": { "title": "项目数量", "value_type": { "kind": "integer", "min": 1, "max": 20 }, "default": 3, "scope": "user", "apply": "restart_instance" },
    "style": { "title": "显示样式", "value_type": { "kind": "enum", "choices": ["compact", "expanded"] }, "default": "compact", "scope": "project", "apply": "restart_instance" }
  },
  "protocol": 7,
  "api": {
    "base": "^1",
    "required": { "package.assets": "^1", "ui.native": "^1", "workspace.files": "^1", "storage.private": "^1", "storage.editor": "^1", "ui.clipboard": "^1", "editor.documents": "^1", "ui.panels": "^1", "configuration": "^1", "plugin.commands":"^1", "ui.interaction":"^1", "files.selection":"^1" },
    "optional": { "example.future": "^9", "ui.canvas": "^1", "editor.viewport": "^1", "language.completion": "^1", "language.structure": "^1" }
  },
  "component": "capability-example.wasm",
  "permissions": ["assets.read", "workspace.read", "storage", "clipboard", "editor.read", "editor.write", "ui.panels", "commands.call", "ui.interaction", "files.select"],
  "panels": [{ "id": "welcome", "title": "Capability Example", "position": "right" }],
  "commands": [
    { "id":"interaction-file", "title":"选择文件并显示信息 / File information", "menu":true, "menus":[{"location":"editor","group":"interaction","order":10},{"location":"selection","group":"interaction","order":10,"when":{"has_selection":true}},{"location":"explorer","group":"interaction","order":10},{"location":"tab","group":"interaction","order":10}] },
    { "id":"interaction-directory", "title":"选择目录 / Choose directory", "menu":true },
    { "id":"interaction-save", "title":"选择保存位置 / Choose save destination", "menu":true },
    { "id":"echo", "title":"类型化回显 / Typed echo", "signature":{"parameters":{"type":"string","max_bytes":64},"result":{"type":"string","max_bytes":64},"permissions":[]} },
    { "id":"command-release", "title":"发布延后命令结果 / Release deferred command" },
    { "id": "fault-spin", "title": "演示执行预算耗尽", "menu": true },
    { "id": "fault-memory", "title": "演示内存预算耗尽", "menu": true },
    { "id": "service-forge-host-reference", "title": "验证伪造宿主引用拒绝" },
    { "id": "service-open", "title": "发现示例服务" },
    { "id": "service-call", "title": "调用示例服务" },
    { "id": "service-cancel", "title": "取消示例调用" },
    { "id": "service-call-contract", "title": "按名字调用服务契约" },
    { "id": "service-last-answer", "title": "查看上次服务答复" },
    { "id": "service-reply-deferred", "title": "完成延后服务答复" },
    { "id": "service-replay-reply", "title": "检查过期回复拒绝" },
    { "id": "execution-defer-next", "title": "延后下一次进程创建答复" },
    { "id": "execution-release", "title": "发布已创建进程的答复" },
    { "id": "ui-layout", "title": "切换示例布局" },
    { "id": "check-errors", "title": "检查类型化错误" },
    { "id": "scope-write", "title": "写入当前作用域" },
    { "id": "scope-read", "title": "读取当前作用域" },
    { "id": "scope-probe", "title": "检查作用域契约" },
    { "id": "preview-probe", "title": "检查原生预览契约" },
    { "id": "process-events", "title": "查看进程事件" },
    { "id": "close-on-output", "title": "首个输出后关闭进程" },
    { "id": "read-selection", "title": "读取选区及文档版本" },
    { "id": "active-directory", "title": "读取活动目录" },
    { "id": "save-document", "title": "保存已读取版本的文档" },
    { "id": "hide-panel", "title": "隐藏自身面板" },
    { "id": "show-panel", "title": "显示自身面板" },
    { "id": "cancel-request", "title": "取消当前请求" },
    { "id": "subscribe-documents", "title": "订阅文档变化" },
    { "id": "unsubscribe-documents", "title": "释放文档订阅" }
  ],
  "storage_limit": 4096
}
