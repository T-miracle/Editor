{
  "schema_version": 1,
  "icons": [
    {
      "extensions": ["rs"],
      "light": "icons/rust.svg",
      "dark": "icons/rust_dark.svg"
    },
    {
      "files": [
        "Cargo.toml",
        "rust-toolchain",
        "rust-toolchain.toml",
        ".cargo/config",
