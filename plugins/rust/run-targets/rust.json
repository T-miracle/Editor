{
  "version": 1,
  "id": "rust-binary",
  "name": "Rust 可执行目标",
  "target_type": "rust-binary",
  "program_field": "program",
  "rules": [
    {
      "file": "Cargo.toml",
      "fields": [
        {"name": "package", "section": "package", "key": "name"},
        {"name": "version", "section": "package", "key": "version", "optional": true},
        {"name": "program", "key": "program", "default": "cargo", "optional": true},
        {"name": "program_args", "key": "program_args", "default": "run", "optional": true},
        {"name": "build_program", "key": "build_program", "default": "cargo.exe", "optional": true},
        {"name": "build_args", "key": "build_args", "default": "build", "optional": true}
      ],
      "targets": [
        {"name_from": "package", "fields": ["package", "version", "program", "program_args", "build_program", "build_args"]}
      ]
    },
    {
      "file": "Cargo.toml",
      "when_present": "bin",
      "fields": [
        {"name": "bin", "section": "bin", "key": "name"},
        {"name": "package", "section": "package", "key": "name", "optional": true},
        {"name": "program", "key": "program", "default": "cargo", "optional": true},
        {"name": "program_args", "key": "program_args", "default": "run", "optional": true},
        {"name": "build_program", "key": "build_program", "default": "cargo.exe", "optional": true},
        {"name": "build_args", "key": "build_args", "default": "build", "optional": true}
      ],
      "targets": [
        {"name_from": "bin", "fields": ["bin", "package", "program", "program_args", "build_program", "build_args"]}
      ]
    }
  ]
}
